# Server
PORT=3001
NODE_ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arenablast
DB_USER=postgres
DB_PASSWORD=yourpassword

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Game config
GAME_TICK_RATE=30
MAP_WIDTH=1200
MAP_HEIGHT=800
PARTICLE_COUNT=30
PLAYER_SPEED=4
PLAYER_HP=100
ATTACK_DAMAGE=25
ATTACK_RANGE=60
PARTICLE_SCORE=10

# Admin
ADMIN_SECRET=admin-seed-secret

# Azure Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure Computer Vision moderation
# Store AZURE-VISION-KEY in Key Vault instead of this file.
AZURE_KEY_VAULT_NAME=
AZURE_VISION_ENDPOINT=
AZURE_VISION_MODERATION_ENABLED=false
AZURE_VISION_ADULT_THRESHOLD=0.60
AZURE_VISION_RACY_THRESHOLD=0.70
AZURE_VISION_GORE_THRESHOLD=0.60

# OpenTelemetry / Grafana Cloud
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
