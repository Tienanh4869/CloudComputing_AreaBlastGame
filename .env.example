# Server
PORT=3001
NODE_ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arenablast
DB_USER=postgres
DB_PASSWORD=yourpassword

# Redis (optional — game degrades gracefully without it)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS allowed origin
CORS_ORIGIN=http://localhost:5173

# Game configuration
GAME_TICK_RATE=30
MAP_WIDTH=1200
MAP_HEIGHT=800
PARTICLE_COUNT=30
PLAYER_SPEED=4
PLAYER_HP=100
ATTACK_DAMAGE=25
ATTACK_RANGE=60
PARTICLE_SCORE=10

# Azure Application Insights (optional observability)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx
